{
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File ./Hooks/scripts/safety-check.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "lint-checker": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File ./Hooks/scripts/lint-check.ps1",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File ./Hooks/scripts/lint-check.ps1",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "session-monitor": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "powershell -File ./Hooks/scripts/session-summary.ps1"
      }
    ]
  }
}
